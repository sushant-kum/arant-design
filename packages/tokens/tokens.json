{
  "$description": "ARANT DESIGN design tokens (W3C Design Tokens format). The single source of truth for colour, type, spacing, layout, radius and motion: the logo artwork, exports, print files, brand guide and website all read these values.",
  "color": {
    "$type": "color",
    "ivory": {
      "$value": "#F1E9DC",
      "$description": "Ground for print and screen.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Warm Ivory"
        }
      }
    },
    "sand": {
      "$value": "#D8C3A7",
      "$description": "Secondary ground, tags, tissue.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Sand"
        }
      }
    },
    "earth": {
      "$value": "#4A3527",
      "$description": "Primary logo colour.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Earth Brown"
        }
      }
    },
    "charcoal": {
      "$value": "#292622",
      "$description": "Text, signage, maximum contrast.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Deep Charcoal"
        }
      }
    },
    "terracotta": {
      "$value": "#B85F32",
      "$description": "Accent: one element per piece, like a seal, a band or a rule; as text, 24 px and larger only.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Terracotta"
        }
      }
    },
    "olive": {
      "$value": "#64654A",
      "$description": "Supporting colour, sparingly.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Muted Olive"
        }
      }
    },
    "kraft": {
      "$value": "#C4A57F",
      "$description": "Reference only: typical kraft board, for mockups and contrast checks.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Kraft"
        }
      }
    },
    "role": {
      "$description": "Semantic colour roles, light theme (the default). Each is an alias of a palette colour, or a mix of two recorded under $extensions[\"com.arantdesign\"].mix, which `pnpm identity:check` verifies against the palette.",
      "surface": {
        "ground": {
          "$value": "{color.ivory}",
          "$description": "Page background."
        },
        "alt": {
          "$value": "{color.sand}",
          "$description": "Alternating sections, image backdrops, footers."
        },
        "inverse": {
          "$value": "{color.charcoal}",
          "$description": "Dark bands, footers, signage."
        }
      },
      "text": {
        "primary": {
          "$value": "{color.charcoal}",
          "$description": "Body and UI text."
        },
        "secondary": {
          "$value": "{color.earth}",
          "$description": "Headings, emphasis, links."
        },
        "muted": {
          "$value": "#6F5D4F",
          "$description": "Metadata and captions, on Ivory only (5.2 : 1); not on Sand (3.7 : 1).",
          "$extensions": {
            "com.arantdesign": {
              "mix": ["{color.earth}", "{color.ivory}", 0.22]
            }
          }
        },
        "inverse": {
          "$value": "{color.ivory}",
          "$description": "Text on Charcoal or Earth."
        }
      },
      "line": {
        "subtle": {
          "$value": "#DFCEB8",
          "$description": "Decorative dividers only (1.3 : 1 on Ivory); never an interactive boundary.",
          "$extensions": {
            "com.arantdesign": {
              "mix": ["{color.sand}", "#FFFFFF", 0.19]
            }
          }
        },
        "strong": {
          "$value": "{color.earth}",
          "$description": "Input borders, focus rings, anything interactive."
        }
      },
      "accent": {
        "$value": "{color.terracotta}",
        "$description": "One accent element per surface; never small text."
      }
    },
    "roleDark": {
      "$description": "Optional dark theme, from the brand guide's dark mixes. Light stays the default; use the reversed logo files on it.",
      "surface": {
        "ground": {
          "$value": "#1F1C1A",
          "$description": "Page background.",
          "$extensions": {
            "com.arantdesign": {
              "mix": ["{color.charcoal}", "#000000", 0.25]
            }
          }
        },
        "alt": {
          "$value": "{color.charcoal}",
          "$description": "Panels."
        }
      },
      "text": {
        "primary": {
          "$value": "{color.ivory}",
          "$description": "Body and UI text, headings."
        },
        "muted": {
          "$value": "#B8A78F",
          "$description": "Metadata and captions.",
          "$extensions": {
            "com.arantdesign": {
              "mix": ["{color.sand}", "{color.charcoal}", 0.18]
            }
          }
        }
      },
      "line": {
        "subtle": {
          "$value": "#3A362F",
          "$description": "Decorative dividers only.",
          "$extensions": {
            "com.arantdesign": {
              "mix": ["{color.charcoal}", "{color.sand}", 0.1]
            }
          }
        },
        "strong": {
          "$value": "{color.ivory}",
          "$description": "Input borders, focus rings, anything interactive."
        }
      },
      "accent": {
        "$value": "#C57C57",
        "$description": "One accent element per surface (5.2 : 1 on the dark ground).",
        "$extensions": {
          "com.arantdesign": {
            "mix": ["{color.terracotta}", "#FFFFFF", 0.18]
          }
        }
      }
    }
  },
  "logo": {
    "$type": "color",
    "default": {
      "$value": "{color.earth}",
      "$description": "Logo on light grounds."
    },
    "reversed": {
      "$value": "{color.ivory}",
      "$description": "Logo on dark grounds."
    },
    "accent": {
      "$value": "{color.terracotta}",
      "$description": "One-colour logo in the accent, e.g. seals."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Jost", "Futura", "Century Gothic", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "Primary: labels, navigation, product details, packaging copy. SIL OFL 1.1."
      },
      "serif": {
        "$value": ["Newsreader", "Iowan Old Style", "Georgia", "serif"],
        "$description": "Secondary: headlines, product names, editorial. Never all caps. SIL OFL 1.1."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": 300,
        "$description": "Newsreader display."
      },
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500,
        "$description": "Jost labels and emphasis."
      }
    }
  },
  "letterSpacing": {
    "$type": "dimension",
    "label": {
      "$value": "0.2em",
      "$description": "Uppercase labels set in Jost."
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale on a 4 px base. Space between sections is always at least one step larger than space inside them.",
    "1": {
      "$value": "4px",
      "$description": "Icon to label."
    },
    "2": {
      "$value": "8px",
      "$description": "Label to value; tight stacks."
    },
    "3": {
      "$value": "12px",
      "$description": "Heading to its text; card text lines."
    },
    "4": {
      "$value": "16px",
      "$description": "Grid gap on phones; form field spacing."
    },
    "5": {
      "$value": "24px",
      "$description": "Grid gap on desktop; image to caption group."
    },
    "6": {
      "$value": "32px",
      "$description": "Between groups inside a section."
    },
    "7": {
      "$value": "48px",
      "$description": "Section header to section content."
    },
    "8": {
      "$value": "64px",
      "$description": "Section spacing on phones."
    },
    "9": {
      "$value": "96px",
      "$description": "Section spacing on desktop."
    },
    "10": {
      "$value": "144px",
      "$description": "Major breaks: before the footer, between editorial chapters."
    }
  },
  "container": {
    "$type": "dimension",
    "text": {
      "$value": "64ch",
      "$description": "Reading text, product descriptions, forms."
    },
    "content": {
      "$value": "1120px",
      "$description": "Default page content."
    },
    "wide": {
      "$value": "1440px",
      "$description": "Wide image grids and editorial spreads."
    }
  },
  "gutter": {
    "$type": "dimension",
    "$description": "Page side margin on every screen: clamp(gutter.min, gutter.preferred, gutter.max).",
    "min": {
      "$value": "20px"
    },
    "preferred": {
      "$value": "5vw"
    },
    "max": {
      "$value": "64px"
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Minimum widths, mobile first; the base layout (phones) starts at 0.",
    "md": {
      "$value": "600px",
      "$description": "Tablet: 6-column grid, 2-up images."
    },
    "lg": {
      "$value": "960px",
      "$description": "Desktop: 12-column grid, split layouts."
    },
    "xl": {
      "$value": "1440px",
      "$description": "Wide: container.wide grids; more space, not more columns."
    }
  },
  "grid": {
    "columns": {
      "$type": "number",
      "phone": {
        "$value": 4
      },
      "tablet": {
        "$value": 6
      },
      "desktop": {
        "$value": 12
      }
    },
    "gap": {
      "$type": "dimension",
      "phone": {
        "$value": "{space.4}"
      },
      "tablet": {
        "$value": "20px"
      },
      "desktop": {
        "$value": "{space.5}"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px",
      "$description": "The default: images, sections, panels, cards, modals, menus, banners."
    },
    "soft": {
      "$value": "2px",
      "$description": "Buttons, inputs, selects, small tags: an eased edge, echoing the logo's caps."
    },
    "round": {
      "$value": "50%",
      "$description": "Truly circular items only: avatar, seal, colour-swatch dot, radio button."
    }
  },
  "border": {
    "$type": "border",
    "$description": "Hairlines. There is no shadow token: layers are separated by colour and hairlines.",
    "subtle": {
      "$value": {
        "color": "{color.role.line.subtle}",
        "width": "1px",
        "style": "solid"
      },
      "$description": "Dividers only."
    },
    "strong": {
      "$value": {
        "color": "{color.role.line.strong}",
        "width": "1px",
        "style": "solid"
      },
      "$description": "Inputs, secondary buttons, anything interactive."
    }
  },
  "duration": {
    "$type": "duration",
    "quick": {
      "$value": "150ms"
    },
    "standard": {
      "$value": "250ms"
    },
    "gentle": {
      "$value": "400ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "out": {
      "$value": [0, 0, 0.58, 1],
      "$description": "CSS ease-out."
    },
    "inOut": {
      "$value": [0.42, 0, 0.58, 1],
      "$description": "CSS ease-in-out."
    }
  },
  "motion": {
    "$type": "transition",
    "$description": "Fades and short slides only (16 px of travel at most). Honour prefers-reduced-motion.",
    "quick": {
      "$value": {
        "duration": "{duration.quick}",
        "delay": "0ms",
        "timingFunction": "{easing.out}"
      },
      "$description": "Hover colour and underline changes."
    },
    "standard": {
      "$value": {
        "duration": "{duration.standard}",
        "delay": "0ms",
        "timingFunction": "{easing.out}"
      },
      "$description": "Drawers, menus, accordions."
    },
    "gentle": {
      "$value": {
        "duration": "{duration.gentle}",
        "delay": "0ms",
        "timingFunction": "{easing.inOut}"
      },
      "$description": "Image cross-fades, section fade-in on load."
    }
  }
}
