{
  "$description": "ARANT DESIGN design tokens (W3C Design Tokens format). The single source of truth for colour and type: the logo artwork, exports, print files, brand guide and website all read these values.",
  "color": {
    "$type": "color",
    "ivory": {
      "$value": "#F1E9DC",
      "$description": "Ground for print and screen.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Warm Ivory"
        }
      }
    },
    "sand": {
      "$value": "#D8C3A7",
      "$description": "Secondary ground, tags, tissue.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Sand"
        }
      }
    },
    "earth": {
      "$value": "#4A3527",
      "$description": "Primary logo colour.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Earth Brown"
        }
      }
    },
    "charcoal": {
      "$value": "#292622",
      "$description": "Text, signage, maximum contrast.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Deep Charcoal"
        }
      }
    },
    "terracotta": {
      "$value": "#B85F32",
      "$description": "Accent: one element per piece, like a seal, a band or a price.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Terracotta"
        }
      }
    },
    "olive": {
      "$value": "#64654A",
      "$description": "Supporting colour, sparingly.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Muted Olive"
        }
      }
    },
    "kraft": {
      "$value": "#C4A57F",
      "$description": "Reference only: typical kraft board, for mockups and contrast checks.",
      "$extensions": {
        "com.arantdesign": {
          "name": "Kraft"
        }
      }
    }
  },
  "logo": {
    "$type": "color",
    "default": {
      "$value": "{color.earth}",
      "$description": "Logo on light grounds."
    },
    "reversed": {
      "$value": "{color.ivory}",
      "$description": "Logo on dark grounds."
    },
    "accent": {
      "$value": "{color.terracotta}",
      "$description": "One-colour logo in the accent, e.g. seals."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Jost", "Futura", "Century Gothic", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "Primary: labels, navigation, product details, packaging copy. SIL OFL 1.1."
      },
      "serif": {
        "$value": ["Newsreader", "Iowan Old Style", "Georgia", "serif"],
        "$description": "Secondary: headlines, product names, editorial. Never all caps. SIL OFL 1.1."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": 300,
        "$description": "Newsreader display."
      },
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500,
        "$description": "Jost labels and emphasis."
      }
    }
  },
  "letterSpacing": {
    "$type": "dimension",
    "label": {
      "$value": "0.2em",
      "$description": "Uppercase labels set in Jost."
    }
  }
}
